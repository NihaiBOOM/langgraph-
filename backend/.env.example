# === 应用配置 ===
APP_NAME=智能售后工单系统
APP_ENV=development
DEBUG=true

# === 数据库 ===
# 默认使用 PostgreSQL（LangGraph Agent Checkpoint 需要）
# 首次使用请确保已安装 PostgreSQL 并创建数据库
# Windows 下载: https://www.postgresql.org/download/windows/
# 安装后执行: createdb after_sales
DATABASE_URL=postgresql+psycopg://postgres:123456@localhost:5432/after_sales

# === JWT ===
JWT_SECRET_KEY=dev-change-me-in-production-please-use-env
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# === 模型 API ===
# 使用阿里云百炼平台（DashScope）
# 申请地址: https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=请填入你的百炼API Key
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3