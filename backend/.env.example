# === 应用配置 ===
APP_NAME=智能售后工单系统
APP_ENV=development
DEBUG=true

# === 数据库（阶段 2 启用）===
# DATABASE_URL=postgresql+psycopg://postgres:123456@localhost:5432/after_sales

# === JWT（阶段 4 启用）===
# JWT_SECRET_KEY=请替换为随机密钥
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=1440

# === 模型 API（阶段 8 启用）===
# 使用阿里云百炼平台（DashScope）
# DASHSCOPE_API_KEY=请填入你的百炼API Key
# LLM_MODEL=qwen-plus
# EMBEDDING_MODEL=text-embedding-v3